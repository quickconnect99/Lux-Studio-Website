{
  "name": "lux-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run env:check && next build",
    "env:check": "node scripts/validate-production-env.mjs",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "start": "node scripts/smart-start.mjs",
    "start:prod": "next start",
    "lint": "eslint app components hooks lib next.config.mjs playwright.config.ts scripts tests --max-warnings=0 --cache",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-unit-tests.mjs",
    "test:coverage": "c8 --all \"--include=lib/**/*.ts\" \"--include=app/api/inquiries/route.ts\" \"--include=app/api/telemetry/route.ts\" \"--include=app/api/admin/revalidate/route.ts\" \"--include=app/api/admin/retention/route.ts\" \"--include=app/api/admin/notifications/route.ts\" \"--include=app/api/admin/users/route.ts\" --reporter=text --reporter=lcov --reports-dir=coverage --exclude=tests/** --exclude=scripts/** --check-coverage --lines=75 --statements=75 --functions=80 --branches=70 node scripts/run-unit-tests.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "migrations:check": "node scripts/check-migrations.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "smoke:live": "node scripts/smoke-test-live.mjs",
    "smoke:images": "node scripts/check-live-images.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "2.104.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.2",
    "lucide-react": "^0.511.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.0.2",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "c8": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.12",
    "postcss": "^8.5.24",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.24",
      "sharp": "0.35.3"
    }
  }
}
